TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ADMINS=123456,654321
TIMEZONE=Europe/London
OPENAI_API_KEY=sk-or-v1-***
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4.1-nano
HTTP_PROXY=http://login:password@example.com:8080

# System Monitoring Configuration
MONITORING_ENABLED=true
MONITORING_INTERVAL=300
MONITOR_RAID=true
MONITOR_CPU=true
CPU_THRESHOLD=80.0
MONITOR_DURATION=1200
MONITOR_TEMPERATURE=true
TEMPERATURE_DEVICES=coretemp,cpu,thermal
TEMPERATURE_THRESHOLD=60.0
NOTIFICATION_COOLDOWN=3600

# Data Logging Configuration
LOG_DEPTH_MINUTES=1440
LOG_DELAY=60

# Plotting Configuration
IGNORE_PLOT_DEVICES_TEMPERATURE=
IGNORE_PLOT_DEVICES_DISK=
IGNORE_PLOT_DEVICES_IO=
ALIASES_TEMPERATURE=
ALIASES_DISK=
ALIASES_IO=